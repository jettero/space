[Unit]
Description=space (appserv ssh game host)

[Service]
Environment=SPACE=%h/code/python/space BIND=127.0.0.1:2222
EnvironmentFile=-%E/space/env
ExecStart=/usr/bin/env -C ${SPACE} ${APPSERV_DIR}/target/debug/appserv ${SPACE} --prefix ${SPACE}/data --bind ${BIND}
Restart=on-failure

[Install]
WantedBy=default.target
